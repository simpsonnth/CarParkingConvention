APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Lessons learned attachments (use "google" in production; "local" for tests/dev without Drive)
LESSONS_LEARNED_DISK=google
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional Drive folder ID to keep uploads under a specific folder
GOOGLE_DRIVE_FOLDER_ID=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local (MailHog / Mailpit): MAIL_MAILER=smtp, HOST=localhost, PORT=1025
# Live primary (Resend SMTP): MAIL_MAILER=smtp + MAIL_HOST=smtp.resend.com
# Failover chain when a provider hits quota:
#   MAIL_TRANSACTIONAL_PRIMARY=smtp
#   MAIL_TRANSACTIONAL_FAILOVER=brevo
#   MAIL_TRANSACTIONAL_TERTIARY=mailersend
# If all three are exhausted, outbound emails stay queued until a reset.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@jwconv.uk"
MAIL_FROM_NAME="Convention Parking"
MAIL_TRANSACTIONAL_PRIMARY=smtp
MAIL_TRANSACTIONAL_FAILOVER=brevo
MAIL_TRANSACTIONAL_TERTIARY=mailersend

RESEND_API_KEY=
# Signing secret from Resend → Webhooks (whsec_…) for /webhooks/resend
RESEND_WEBHOOK_SECRET=

# Brevo SMTP failover (smtp-relay.brevo.com) — use the SMTP key, not the API key
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
BREVO_MAIL_SCHEME=smtp
# Optional but recommended: API key so we detect when free send credits hit 0
# (Brevo SMTP can still accept mail after the limit is exhausted).
BREVO_API_KEY=

# MailerSend tertiary failover (API transport). Domain/sender must be verified.
# Free plan = 100 API requests/day; leave a reserve so we never burn the full cap.
MAILERSEND_API_KEY=
MAILERSEND_API_RESERVE=5

CHROME_PATH=/usr/bin/google-chrome-stable

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
